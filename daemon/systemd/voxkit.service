# User unit for the voxkit dictation daemon (installed by fcitx5-voxkit).
# Enable: systemctl --user enable --now voxkit.service
#
# Models: voxkit's own store is ~/.local/share/voxkit/models (download,
# delete, select happen there). The Hex app's model folder is used as a
# READ-ONLY fallback when it already has a model (checksums verified), so no
# second 850 MB download is needed. voxkit never writes to it, and systemd
# below makes that folder read-only for this service as well.
[Unit]
Description=voxkit local dictation daemon (fcitx5-voxkit)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=VOXKIT_MODELS_DIR=%h/.local/share/voxkit/models
Environment=VOXKIT_READONLY_MODELS_DIRS=%h/.local/share/hex/models
# Preferred speech model. If that file is not in the store, the daemon
# uses any installed ASR model (typically whisper-tiny) and logs the
# fallback. Install the preferred one with: voxkit model install qwen3-asr-0.6b
Environment=VOXKIT_MODEL=qwen3-asr-0.6b
# Tuning (defaults shown): ASR threads = cores-2 capped at 8; prompt budget in
# characters (each costs ~4 ms of decoding on CPU, 0 disables the prompt).
#Environment=VOXKIT_THREADS=8
#Environment=VOXKIT_PROMPT_CHARS=40
# Models load on first use (preloading starts when the hotkey goes down) and
# are unloaded after this many idle seconds; "never" keeps them in memory.
# VOXKIT_MT_IDLE_UNLOAD overrides it for the translation model only.
#Environment=VOXKIT_IDLE_UNLOAD=600
#Environment=VOXKIT_MT_IDLE_UNLOAD=600
# VOXKIT_PREWARM=1 restores the old behaviour: load the speech model at start.
#Environment=VOXKIT_PREWARM=1
ExecStart=/usr/bin/voxkit serve
Restart=on-failure
RestartSec=2
# Read the models; write only the runtime dir (socket) and voxkit's own store.
ProtectSystem=strict
ProtectHome=read-only
# Creates ~/.local/share/voxkit (user units: StateDirectory = $XDG_STATE_HOME,
# so use the data dir explicitly) before the sandbox is set up.
ExecStartPre=+/usr/bin/mkdir -p %h/.local/share/voxkit/models
ReadWritePaths=%t -%h/.local/share/voxkit/models
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
